---
/**
 * Çalışma yaklaşımı — masaüstünde kaydırdıkça yatay ilerleyen sabitlenmiş bölüm,
 * mobilde / hareket azaltıldığında dikey zaman çizelgesi.
 */
import Split from '../Split.astro';
import Icon from '../Icon.astro';
import { process } from '../../data/content';
---

<section class="process" aria-labelledby="surec-baslik" data-process>
  <div class="process__sticky">
    <div class="container process__head">
      <div>
        <p class="label eyebrow" data-reveal>Birlikte nasıl çalışırız</p>
        <Split id="surec-baslik" class="h2" text="İhtiyaçtan *uygulamaya*, beş adımda." />
      </div>
      <div class="process__meta">
        <p class="process__count num" aria-hidden="true">
          <span data-process-current>01</span><span class="muted"> / 0{process.length}</span>
        </p>
        <a href="/yaklasim/" class="link-arrow">Yaklaşımımızın ayrıntıları <Icon name="arrow" /></a>
      </div>
    </div>

    <div class="process__viewport">
      <ol class="process__track" role="list" data-process-track>
        <li class="process__rail" aria-hidden="true">
          <span class="process__rail-fill"></span>
        </li>
        {
          process.map((step, i) => (
            <li class="step" data-step style={`--i:${i}`}>
              <span class="step__node" aria-hidden="true" />
              <p class="step__num num">0{i + 1}</p>
              <h3 class="step__title h3">
                {step.title}
                <span class="dot">.</span>
              </h3>
              <p class="step__sub label">{step.subtitle}</p>
              <p class="step__text muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    padding-block: var(--section);
  }
  .process__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .process__head .h2 {
    margin-top: 1.25rem;
    max-width: 16ch;
  }
  .process__meta {
    display: grid;
    justify-items: end;
    gap: 0.75rem;
  }
  .process__count {
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    line-height: 1;
    font-weight: 300;
    color: var(--bordo);
  }
  .process__count .muted {
    font-size: 0.4em;
    vertical-align: top;
  }

  .process__viewport {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .process__track {
    position: relative;
    display: grid;
    gap: 0;
    padding-inline: var(--gutter);
    max-width: var(--max);
    margin-inline: auto;
  }

  /* Dikey (varsayılan: mobil, tablet, hareket azaltma) */
  .process__rail {
    position: absolute;
    left: calc(var(--gutter) + 7px);
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--line-strong);
  }
  .process__rail-fill {
    display: none;
  }
  .process:not(.is-pinned) .process__count {
    display: none;
  }
  .step {
    position: relative;
    padding: 0 0 2.75rem 3rem;
    display: grid;
    gap: 0.5rem;
  }
  .step:last-child {
    padding-bottom: 0;
  }
  .step__node {
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--teal);
  }
  .step:last-child .step__node {
    background: var(--bordo);
    border-color: var(--bordo);
  }
  .step__num {
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
  .step__sub {
    color: var(--bordo);
    margin-top: 0.25rem;
  }
  .step__text {
    max-width: 44ch;
    margin-top: 0.5rem;
  }

  /* Yatay, sabitlenmiş (masaüstü) */
  .process.is-pinned {
    padding-block: 0;
  }
  .process.is-pinned .process__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .process.is-pinned .process__viewport {
    margin-top: clamp(2.5rem, 7vh, 5rem);
  }
  .process.is-pinned .process__track {
    display: flex;
    gap: clamp(2.5rem, 4vw, 5rem);
    max-width: none;
    margin: 0;
    width: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding-top: 3.5rem;
    transform: translate3d(calc(var(--x, 0) * -1px), 0, 0);
    will-change: transform;
  }
  .process.is-pinned .process__rail {
    left: 0;
    right: 0;
    top: 0.45rem;
    bottom: auto;
    width: auto;
    height: 1px;
  }
  .process.is-pinned .process__rail-fill {
    display: block;
    position: absolute;
    inset: 0;
    background: var(--bordo);
    transform-origin: left;
    transform: scaleX(var(--fill, 0));
  }
  .process.is-pinned .step {
    width: clamp(300px, 30vw, 440px);
    padding: 0;
    align-content: start;
    opacity: 0.35;
    transition: opacity 0.6s ease;
  }
  .process.is-pinned .step.is-current,
  .process.is-pinned .step.is-past {
    opacity: 1;
  }
  .process.is-pinned .step__node {
    top: -3.5rem;
    transform: translateY(-50%);
    margin-top: 0.45rem;
    transition:
      background-color 0.4s,
      border-color 0.4s,
      transform 0.5s var(--ease-out);
  }
  .process.is-pinned .step.is-current .step__node,
  .process.is-pinned .step.is-past .step__node {
    background: var(--bordo);
    border-color: var(--bordo);
  }
  .process.is-pinned .step.is-current .step__node {
    transform: translateY(-50%) scale(1.5);
  }
  .process.is-pinned .step__num {
    font-size: clamp(3.5rem, 3rem + 2vw, 5.5rem);
    font-weight: 250;
    line-height: 1;
    color: var(--teal-soft);
    margin-bottom: 1rem;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-process]');
  if (section) {
    const track = section.querySelector<HTMLElement>('[data-process-track]')!;
    const steps = Array.from(section.querySelectorAll<HTMLElement>('[data-step]'));
    const counter = section.querySelector<HTMLElement>('[data-process-current]')!;
    const desktop = window.matchMedia('(min-width: 1024px) and (min-height: 620px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let distance = 0;
    let raf = 0;

    const measure = () => {
      const pinned = desktop.matches && !reduced.matches;
      section.classList.toggle('is-pinned', pinned);
      if (!pinned) {
        section.style.height = '';
        track.style.removeProperty('--x');
        steps.forEach((s) => s.classList.remove('is-current', 'is-past'));
        return;
      }
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      section.style.height = `${window.innerHeight + distance}px`;
      update();
    };

    const update = () => {
      raf = 0;
      if (!section.classList.contains('is-pinned')) return;
      const rect = section.getBoundingClientRect();
      const total = section.offsetHeight - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      track.style.setProperty('--x', String(p * distance));
      track.style.setProperty('--fill', String(p));
      const current = Math.min(steps.length - 1, Math.floor(p * steps.length * 0.999));
      steps.forEach((s, i) => {
        s.classList.toggle('is-current', i === current);
        s.classList.toggle('is-past', i < current);
      });
      counter.textContent = `0${current + 1}`;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!raf) raf = requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', measure);
    desktop.addEventListener('change', measure);
    reduced.addEventListener('change', measure);
    document.fonts?.ready.then(measure);
    measure();

    // Klavye ile adımlar arasında gezinirken ilgili adım görünür olsun
    steps.forEach((s, i) =>
      s.addEventListener('focusin', () => {
        if (!section.classList.contains('is-pinned')) return;
        const total = section.offsetHeight - window.innerHeight;
        const top = section.offsetTop + (total * (i + 0.5)) / steps.length;
        window.scrollTo({ top });
      }),
    );
  }
</script>
