---
import Split from '../Split.astro';
import Motif from '../Motif.astro';
import Icon from '../Icon.astro';
import { services } from '../../data/content';
---

<section class="services section surface-cream" id="alanlar" aria-labelledby="alanlar-baslik">
  <div class="container">
    <header class="services__head">
      <p class="label eyebrow" data-reveal>Neler yapıyoruz</p>
      <Split id="alanlar-baslik" class="h2" text="Üç alan, *tek bir özen*." />
      <p class="services__intro muted" data-reveal style="--d:200">
        Ayrı hizmetler gibi görünseler de hepsi aynı sorudan doğar: İnsanlar bir araya geldiğinde, o zamanı nasıl
        anlamlı kılarız?
      </p>
    </header>

    <ol class="services__list" role="list">
      {
        services.map((s, i) => (
          <li class="svc" data-reveal style={`--d:${i * 90}`}>
            <a href={s.href} class="svc__link" data-activate>
              <span class="svc__index num">{s.index}</span>
              <span class="svc__title">
                {s.title}
                <span class="dot">.</span>
              </span>
              <span class="svc__body">
                <span class="svc__summary">{s.summary}</span>
                <span class="svc__keys">
                  {s.keywords.map((k) => (
                    <span>{k}</span>
                  ))}
                </span>
              </span>
              <span class="svc__visual">
                <Motif variant={s.motif} />
              </span>
              <span class="svc__arrow" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
  }
  .services__head .eyebrow {
    grid-column: 1 / -1;
  }
  .services__intro {
    max-width: 42ch;
    font-size: var(--t-lead);
    line-height: 1.5;
  }

  .services__list {
    border-top: 1px solid var(--line-strong);
  }
  .svc {
    border-bottom: 1px solid var(--line-strong);
  }
  .svc__link {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1.3fr) minmax(0, 1fr) 150px 3rem;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.75rem, 3vw, 2.75rem) 0;
    text-decoration: none;
    isolation: isolate;
  }
  .svc__link::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    z-index: -1;
    background: var(--paper);
    border-radius: 4px;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.7s var(--ease-out);
  }
  .svc__link:hover::before,
  .svc__link:focus-visible::before {
    transform: none;
  }
  .svc__index {
    align-self: start;
    padding-top: 0.9rem;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
  .svc__title {
    font-family: var(--f-display);
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.75rem);
    font-weight: 350;
    letter-spacing: -0.025em;
    line-height: 1.02;
    transition: transform 0.7s var(--ease-out);
  }
  .svc__link:hover .svc__title {
    transform: translateX(0.5rem);
  }
  .svc__body {
    display: grid;
    gap: 1rem;
  }
  .svc__summary {
    color: var(--ink-muted);
    max-width: 40ch;
  }
  .svc__keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .svc__keys span {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }
  .svc__visual {
    width: 150px;
  }
  .svc__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease,
      transform 0.6s var(--ease-out);
  }
  .svc__arrow :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .svc__link:hover .svc__arrow,
  .svc__link:focus-visible .svc__arrow {
    background: var(--bordo);
    border-color: var(--bordo);
    color: var(--paper);
    transform: rotate(-45deg);
  }

  @media (max-width: 1100px) {
    .svc__link {
      grid-template-columns: 3rem minmax(0, 1fr) 120px;
      grid-template-areas:
        'idx title visual'
        'idx body visual';
      gap: 1rem 1.5rem;
    }
    .svc__index {
      grid-area: idx;
    }
    .svc__title {
      grid-area: title;
    }
    .svc__body {
      grid-area: body;
    }
    .svc__visual {
      grid-area: visual;
      width: 120px;
      align-self: center;
    }
    .svc__arrow {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .services__head {
      grid-template-columns: 1fr;
    }
    .svc__link {
      grid-template-columns: minmax(0, 1fr) 84px;
      grid-template-areas:
        'idx visual'
        'title visual'
        'body body';
      gap: 0.5rem 1rem;
    }
    .svc__index {
      padding-top: 0;
    }
    .svc__visual {
      width: 84px;
      align-self: start;
    }
    .svc__body {
      margin-top: 0.75rem;
    }
    .svc__link::before {
      display: none;
    }
  }
</style>

<script>
  import { initActivate } from '../../scripts/activate';
  initActivate();
</script>
